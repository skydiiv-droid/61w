// ───── 프로필 수정 ─────
function ProfileEditor({me,meData,members,onClose}){
  const [name,setName] = useState(meData.name||"");
  const [phone,setPhone] = useState(meData.phone||"");
  const [bMonth,setBMonth] = useState(String(meData.birthMonth||""));
  const [bDay,setBDay] = useState(String(meData.birthDay||""));
  const [color,setColor] = useState(meData.color);
  const [pw,setPw] = useState("");
  const [pw2,setPw2] = useState("");
  const [err,setErr] = useState("");
  const [saving,setSaving] = useState(false);

  const usedColors = new Set();
  const usedNames = new Set();
  Object.entries(members).forEach(([id,m])=>{
    if(id!==me){
      usedColors.add(m.color);
      usedNames.add(m.name);
    }
  });

  const handleSave = async()=>{
    if(!name.trim()) return setErr("이름");
    if(usedNames.has(name.trim())) return setErr("이미 있는 이름");
    const m=parseInt(bMonth),d=parseInt(bDay);
    if(!(m>=1&&m<=12)||!(d>=1&&d<=31)) return setErr("생일 확인");
    const phoneDigits = phone.replace(/\D/g,"");
    if(!/^\d{10,11}$/.test(phoneDigits)) return setErr("전화번호 10~11자리");
    if(pw && pw.length!==4) return setErr("비번은 4자리");
    if(pw && pw!==pw2) return setErr("비번 확인 불일치");
    setErr(""); setSaving(true);
    const updates = {
      name:name.trim(),
      birthMonth:m,birthDay:d,
      phone:formatPhone(phoneDigits),
      color
    };
    if(pw) updates.password = pw;
    await update(ref(db,`${ROOT}/members/${me}`),updates);
    setSaving(false);
    onClose();
  };

  return el("div",{className:"anim-fade",
    onClick:onClose,
    style:{
      position:"fixed",inset:0,background:"var(--modal-bg)",
      zIndex:80,display:"flex",alignItems:"flex-end"
    }
  },
    el("div",{className:"anim-up",
      onClick:e=>e.stopPropagation(),
      style:{
        width:"100%",background:"var(--bg-1)",
        borderRadius:"22px 22px 0 0",
        padding:"20px 18px 28px",
        maxHeight:"88vh",overflowY:"auto"
      }
    },
      el("div",{style:{width:36,height:4,background:"var(--border-soft)",borderRadius:2,margin:"0 auto 14px"}}),
      el("div",{style:{fontSize:18,fontWeight:800,marginBottom:16,color:"var(--text)"}},"개인정보 수정"),

      el("div",{style:{display:"flex",flexDirection:"column",gap:12}},
        field("이름", el("input",{
          type:"text",value:name,onChange:e=>setName(e.target.value.slice(0,8)),
          maxLength:8,style:inputStyle()
        })),
        field("생일 (양력)", el("div",{style:{display:"flex",gap:8,alignItems:"center"}},
          el("input",{type:"tel",inputMode:"numeric",value:bMonth,onChange:e=>setBMonth(e.target.value.replace(/\D/g,"").slice(0,2)),placeholder:"월",style:{...inputStyle(),width:60,textAlign:"center"}}),
          el("span",{style:{color:"var(--text-fainter)"}},"/"),
          el("input",{type:"tel",inputMode:"numeric",value:bDay,onChange:e=>setBDay(e.target.value.replace(/\D/g,"").slice(0,2)),placeholder:"일",style:{...inputStyle(),width:60,textAlign:"center"}})
        )),
        field("전화번호", el("input",{
          type:"tel",inputMode:"numeric",value:phone,
          onChange:e=>setPhone(formatPhone(e.target.value.replace(/\D/g,"").slice(0,11))),
          placeholder:"010-0000-0000",
          style:{...inputStyle(),fontVariantNumeric:"tabular-nums"}
        })),
        field("색상", el("div",{style:{display:"grid",gridTemplateColumns:"repeat(8,1fr)",gap:8,paddingTop:4}},
          MEMBER_COLORS.map(c=>{
            const used = usedColors.has(c) && c!==color;
            return el("button",{key:c,onClick:()=>!used&&setColor(c),
              style:{
                aspectRatio:"1",borderRadius:"50%",
                background:used?"var(--surface-faint)":c,
                border:color===c?"3px solid #2D2D3A":"3px solid transparent",
                opacity:used?0.4:1,
                cursor:used?"not-allowed":"pointer"
              }
            });
          })
        )),
        field("비밀번호 변경 (선택)", el("div",{style:{display:"flex",gap:8}},
          el("input",{type:"tel",inputMode:"numeric",maxLength:4,value:pw,onChange:e=>setPw(e.target.value.replace(/\D/g,"").slice(0,4)),placeholder:"새 비번",style:{...inputStyle(),flex:1,letterSpacing:"0.4em",textAlign:"center"}}),
          el("input",{type:"tel",inputMode:"numeric",maxLength:4,value:pw2,onChange:e=>setPw2(e.target.value.replace(/\D/g,"").slice(0,4)),placeholder:"확인",style:{...inputStyle(),flex:1,letterSpacing:"0.4em",textAlign:"center"}})
        ))
      ),
      err && el("div",{style:{fontSize:13,color:MEMO_COLOR,textAlign:"center",marginTop:10}},err),
      el("div",{style:{display:"flex",gap:8,marginTop:18}},
        el("button",{onClick:onClose,
          style:{flex:1,padding:"14px 0",borderRadius:12,background:"var(--surface)",border:"1px solid #EFE6D5",color:"var(--text-sub)",fontSize:14,fontWeight:600}
        },"취소"),
        el("button",{onClick:handleSave,disabled:saving,
          style:{flex:2,padding:"14px 0",borderRadius:12,background:"var(--text)",color:"var(--surface)",fontSize:14,fontWeight:700,opacity:saving?0.5:1}
        },saving?"저장 중...":"저장")
      )
    )
  );
}

// ───── 계정 삭제 ─────
function DeleteAccount({me,meData,onClose,onDeleted}){
  const [pw,setPw] = useState("");
  const [confirmText,setConfirmText] = useState("");
  const [err,setErr] = useState("");
  const [deleting,setDeleting] = useState(false);

  const handleDelete = async()=>{
    if(meData.password!==pw) return setErr("비번 틀림");
    if(confirmText!=="삭제") return setErr("'삭제' 두 글자를 정확히 입력");
    setErr(""); setDeleting(true);
    // 멤버 정보, 듀티 데이터 모두 삭제 (메모는 다른 사람도 본 거라 본인이 작성한 것만 정리는 복잡 → 보존)
    await remove(ref(db,`${ROOT}/members/${me}`));
    await remove(ref(db,`${ROOT}/schedules/${me}`));
    setDeleting(false);
    onDeleted();
  };

  return el("div",{className:"anim-fade",
    onClick:onClose,
    style:{
      position:"fixed",inset:0,background:"var(--modal-bg)",
      zIndex:80,display:"flex",alignItems:"flex-end"
    }
  },
    el("div",{className:"anim-up",
      onClick:e=>e.stopPropagation(),
      style:{
        width:"100%",background:"var(--bg-1)",
        borderRadius:"22px 22px 0 0",
        padding:"22px 20px 28px"
      }
    },
      el("div",{style:{width:36,height:4,background:"var(--border-soft)",borderRadius:2,margin:"0 auto 14px"}}),
      el("div",{style:{fontSize:18,fontWeight:800,marginBottom:8,color:MEMO_COLOR}},"⚠ 계정 삭제"),
      el("div",{style:{fontSize:13,color:"#5C5040",lineHeight:1.6,marginBottom:18}},
        `${meData.name}의 계정과 입력한 모든 듀티 데이터가 영구 삭제돼. 작성한 메모는 그룹 기록으로 남아. 되돌릴 수 없어.`
      ),
      el("div",{style:{display:"flex",flexDirection:"column",gap:12}},
        field("비밀번호", el("input",{
          type:"tel",inputMode:"numeric",maxLength:4,value:pw,
          onChange:e=>setPw(e.target.value.replace(/\D/g,"").slice(0,4)),
          placeholder:"••••",
          style:{...inputStyle(),letterSpacing:"0.4em",textAlign:"center",fontSize:18,fontWeight:700}
        })),
        field("확인을 위해 '삭제'를 입력", el("input",{
          type:"text",value:confirmText,
          onChange:e=>setConfirmText(e.target.value),
          placeholder:"삭제",
          style:inputStyle()
        }))
      ),
      err && el("div",{style:{fontSize:13,color:MEMO_COLOR,textAlign:"center",marginTop:10}},err),
      el("div",{style:{display:"flex",gap:8,marginTop:18}},
        el("button",{onClick:onClose,
          style:{flex:1,padding:"14px 0",borderRadius:12,background:"var(--surface)",border:"1px solid #EFE6D5",color:"var(--text-sub)",fontSize:14,fontWeight:600}
        },"취소"),
        el("button",{onClick:handleDelete,disabled:deleting,
          style:{flex:1,padding:"14px 0",borderRadius:12,background:MEMO_COLOR,color:"var(--surface)",fontSize:14,fontWeight:700,opacity:deleting?0.5:1}
        },deleting?"삭제 중...":"영구 삭제")
      )
    )
  );
}

// ───── 마운트 ─────
ReactDOM.createRoot(document.getElementById("app")).render(el(App));
</script>
</body>
</html>
