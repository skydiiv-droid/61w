function MyStats({me,members,schedules}){
  const today = new Date();
  const year = today.getFullYear();
  const month = today.getMonth();
  const todayDate = today.getDate();

  const stats = useMemo(()=>{
    const mySchedule = schedules?.[me] || {};
    const counts = {D:0, E:0, N:0, O:0, custom:0};
    let totalNights = 0;
    let maxConsecWork = 0;
    let curConsecWork = 0;

    // 이번 달 카운트
    const daysInMonth = new Date(year, month+1, 0).getDate();
    for(let d=1; d<=daysInMonth; d++){
      const k = dKey(year, month, d);
      const s = mySchedule[k];
      if(!s) continue;
      if(s==="D"||s==="E"||s==="N") counts[s]++;
      else if(s==="O") counts.O++;
      else counts.custom++;
    }

    // 누적 나이트, 최장 연속 근무 (전체 데이터 기준)
    const allDates = Object.keys(mySchedule).sort();
    allDates.forEach(k=>{
      const s = mySchedule[k];
      if(s==="N") totalNights++;
      if(s && s!=="O"){
        curConsecWork++;
        if(curConsecWork > maxConsecWork) maxConsecWork = curConsecWork;
      } else {
        curConsecWork = 0;
      }
    });

    return { counts, totalNights, maxConsecWork };
  },[me,schedules,year,month]);

  const cell = (label, value, color)=>el("div",{style:{
    flex:1,
    background:"var(--surface-faint)",borderRadius:10,padding:"10px 6px",
    textAlign:"center"
  }},
    el("div",{style:{fontSize:18,fontWeight:800,color:color||"var(--text)",letterSpacing:"-0.02em"}},value),
    el("div",{style:{fontSize:10,color:"var(--text-faint)",fontWeight:600,marginTop:2}},label)
  );

  return el("div",{style:{background:"var(--surface)",borderRadius:14,padding:14,marginBottom:14}},
    el("div",{style:{fontSize:13,fontWeight:700,color:"var(--text)",marginBottom:10}},
      `📊 ${month+1}월 통계`),
    el("div",{style:{display:"flex",gap:6,marginBottom:8}},
      cell("Day", stats.counts.D, "var(--shift-d)"),
      cell("Eve", stats.counts.E, "var(--shift-e)"),
      cell("Night", stats.counts.N, "var(--shift-n)"),
      cell("Off", stats.counts.O, "var(--shift-o)")
    ),
    stats.counts.custom>0 && el("div",{style:{fontSize:11,color:"var(--text-faint)",textAlign:"center",marginBottom:6}},
      `기타 ${stats.counts.custom}일`),
    el("div",{style:{display:"flex",gap:6,marginTop:6}},
      cell("누적 나이트", stats.totalNights, "#F5A623"),
      cell("최장 연속 근무", `${stats.maxConsecWork}일`, "var(--text-sub)")
    )
  );
}

function SettingsModal({me,members,schedules,isEditMode,onClose,onLockMode,onFullLogout,onRequestEdit,onOpenNotices}){
  const meData = me ? members[me] : null;
  const [editingCode,setEditingCode] = useState(false);
  const [code,setCode] = useState(meData?.customCode||"");
  const [desc,setDesc] = useState(meData?.customDesc||"");
  const [err,setErr] = useState("");
  const [showProfile,setShowProfile] = useState(false);
  const [showDelete,setShowDelete] = useState(false);
  const [showHelp,setShowHelp] = useState(false);

  const usedCodes = new Set();
  Object.values(members).forEach(m=>{
    if(m.customCode && m.customCode!==meData?.customCode) usedCodes.add(m.customCode);
  });

  const saveCode = async()=>{
    const c = code.toUpperCase().trim();
    if(c==="") {
      await update(ref(db,`${ROOT}/members/${me}`),{customCode:null,customDesc:null});
      setEditingCode(false); return;
    }
    if(c.length!==1) return setErr("한 글자");
    if(!/^[A-Z]$/.test(c)) return setErr("알파벳만");
    if(RESERVED_CODES.includes(c)) return setErr(`${c}는 예약됨 (D/E/N/O)`);
    if(usedCodes.has(c)) return setErr(`${c}는 다른 멤버가 사용 중`);
    setErr("");
    await update(ref(db,`${ROOT}/members/${me}`),{customCode:c,customDesc:desc.trim()||null});
    setEditingCode(false);
  };

  return el("div",{className:"anim-fade",
    onClick:onClose,
    style:{
      position:"fixed",inset:0,background:"var(--modal-bg)",
      zIndex:70,display:"flex",alignItems:"flex-end"
    }
  },
    el("div",{className:"anim-up",
      onClick:e=>e.stopPropagation(),
      style:{
        width:"100%",background:"var(--bg-1)",
        borderRadius:"22px 22px 0 0",
        padding:"20px 18px 28px",
        maxHeight:"85vh",overflowY:"auto"
      }
    },
      el("div",{style:{width:36,height:4,background:"var(--border-soft)",borderRadius:2,margin:"0 auto 18px"}}),
      el("div",{style:{fontSize:18,fontWeight:800,marginBottom:16,color:"var(--text)"}},"설정"),

      // 사용법 (모드 무관)
      el("button",{onClick:()=>setShowHelp(true),
        style:{
          width:"100%",padding:"14px",borderRadius:14,
          background:"var(--surface)",
          fontSize:14,color:"var(--text)",fontWeight:700,
          marginBottom:8,
          display:"flex",alignItems:"center",justifyContent:"space-between"
        }
      },
        el("span",null,"📖 사용법"),
        el("span",{style:{color:"var(--text-faint)"}},"›")
      ),

      // 공지 관리 (모드 무관 - 작성은 모달 안에서 다시 체크)
      el("button",{onClick:()=>{onClose();onOpenNotices && onOpenNotices();},
        style:{
          width:"100%",padding:"14px",borderRadius:14,
          background:"var(--surface)",
          fontSize:14,color:"var(--text)",fontWeight:700,
          marginBottom:14,
          display:"flex",alignItems:"center",justifyContent:"space-between"
        }
      },
        el("span",null,"📢 공지"),
        el("span",{style:{color:"var(--text-faint)"}},"›")
      ),

      // 게스트 모드 안내
      !isEditMode && el("div",{style:{background:"var(--surface)",borderRadius:14,padding:16,marginBottom:14,textAlign:"center"}},
        el("div",{style:{fontSize:32,marginBottom:6}},"🔒"),
        el("div",{style:{fontSize:14,fontWeight:700,color:"var(--text)",marginBottom:6}},"보기 모드"),
        el("div",{style:{fontSize:12,color:"var(--text-faint)",marginBottom:14,lineHeight:1.5}},
