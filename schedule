        el("button",{onClick:()=>{onClose();onRequestEdit();},
          style:{
            width:"100%",padding:"12px 0",borderRadius:12,
            background:"var(--text)",color:"var(--surface)",
            fontSize:14,fontWeight:700
          }
        },"🔓 수정 모드로 진입")
      ),

