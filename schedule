    },
      el("div",{style:{width:36,height:4,background:"var(--border-soft)",borderRadius:2,margin:"0 auto 14px"}}),
      // 헤더
      el("div",{style:{display:"flex",alignItems:"baseline",gap:8,marginBottom:14}},
        el("button",{onClick:goPrevDay,
          style:{fontSize:18,color:"var(--text-faint)",padding:"0 6px"}},"‹"),
        el("div",{style:{fontSize:24,fontWeight:800,color:"var(--text)",letterSpacing:"-0.03em"}},
          `${month+1}월 ${day}일`),
        el("div",{style:{fontSize:14,color:dow===0?"var(--sun)":dow===6?"var(--sat)":"var(--text-faint)",fontWeight:700}},
          `(${WEEKDAYS[dow]})`),
        el("button",{onClick:goNextDay,
