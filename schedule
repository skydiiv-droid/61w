function SignupForm({members,memberCount,onLogin}){
  const [name,setName] = useState("");
  const [bMonth,setBMonth] = useState("");
  const [bDay,setBDay] = useState("");
  const [phone,setPhone] = useState("");
  const [pw,setPw] = useState("");
  const [pw2,setPw2] = useState("");
  const [color,setColor] = useState(MEMBER_COLORS[0]);
  const [err,setErr] = useState("");

  const usedColors = new Set(Object.values(members).map(m=>m.color));
  const usedNames = new Set(Object.values(members).map(m=>m.name));

  const handleSubmit = async()=>{
    if(memberCount>=MAX_MEMBERS) return setErr(`최대 ${MAX_MEMBERS}명`);
    if(!name.trim()) return setErr("이름");
    if(usedNames.has(name.trim())) return setErr("이미 있는 이름");
    const m=parseInt(bMonth),d=parseInt(bDay);
    if(!(m>=1&&m<=12)||!(d>=1&&d<=31)) return setErr("생일 확인");
    const phoneDigits = phone.replace(/\D/g,"");
    if(!/^\d{10,11}$/.test(phoneDigits)) return setErr("전화번호 10~11자리");
    if(pw.length!==4) return setErr("비번 4자리");
    if(pw!==pw2) return setErr("비번 확인 불일치");
    setErr("");

    const newRef = push(ref(db,`${ROOT}/members`));
    const id = newRef.key;
    await set(newRef,{
      name:name.trim(),
      birthMonth:m,birthDay:d,
      phone:formatPhone(phoneDigits),
      password:pw,
      color,
      joinedAt:Date.now()
    });
    onLogin(id);
  };

  return el("div",{className:"anim-down",style:{display:"flex",flexDirection:"column",gap:12}},
    field("이름", el("input",{
      type:"text",value:name,onChange:e=>setName(e.target.value.slice(0,8)),
      placeholder:"이름",maxLength:8,
      style:inputStyle()
    })),
    field("생일 (양력)", el("div",{style:{display:"flex",gap:8,alignItems:"center"}},
      el("input",{type:"tel",inputMode:"numeric",value:bMonth,onChange:e=>setBMonth(e.target.value.replace(/\D/g,"").slice(0,2)),placeholder:"월",style:{...inputStyle(),width:60,textAlign:"center"}}),
      el("span",{style:{color:"var(--text-fainter)"}},"/"),
      el("input",{type:"tel",inputMode:"numeric",value:bDay,onChange:e=>setBDay(e.target.value.replace(/\D/g,"").slice(0,2)),placeholder:"일",style:{...inputStyle(),width:60,textAlign:"center"}})
    )),
    field("전화번호", el("input",{
      type:"tel",inputMode:"numeric",value:phone,
      onChange:e=>setPhone(formatPhone(e.target.value.replace(/\D/g,"").slice(0,11))),
      placeholder:"010-0000-0000",
      style:{...inputStyle(),fontVariantNumeric:"tabular-nums"}
    })),
    field("비밀번호 4자리", el("div",{style:{display:"flex",gap:8}},
      el("input",{type:"tel",inputMode:"numeric",maxLength:4,value:pw,onChange:e=>setPw(e.target.value.replace(/\D/g,"").slice(0,4)),placeholder:"••••",style:{...inputStyle(),flex:1,letterSpacing:"0.4em",textAlign:"center"}}),
      el("input",{type:"tel",inputMode:"numeric",maxLength:4,value:pw2,onChange:e=>setPw2(e.target.value.replace(/\D/g,"").slice(0,4)),placeholder:"확인",style:{...inputStyle(),flex:1,letterSpacing:"0.4em",textAlign:"center"}})
    )),
    field("내 색상", el("div",{style:{display:"grid",gridTemplateColumns:"repeat(8,1fr)",gap:8,paddingTop:4}},
      MEMBER_COLORS.map(c=>{
        const used = usedColors.has(c) && c!==color;
        return el("button",{key:c,onClick:()=>!used&&setColor(c),
          style:{
            aspectRatio:"1",borderRadius:"50%",
            background:used?"var(--surface-faint)":c,
            border:color===c?"3px solid #2D2D3A":"3px solid transparent",
            opacity:used?0.4:1,
            cursor:used?"not-allowed":"pointer",
            transition:"all 0.15s"
          }
        });
      })
    )),
    err && el("div",{style:{fontSize:13,color:MEMO_COLOR,textAlign:"center",marginTop:4}},err),
    el("button",{onClick:handleSubmit,
      style:{
        marginTop:8,padding:"16px 0",borderRadius:14,
        background:"var(--text)",color:"var(--surface)",
        fontSize:15,fontWeight:700
      }
    },"가입하기")
  );
}

const inputStyle = ()=>({
  width:"100%",fontSize:15,padding:"10px 12px",
  background:"var(--surface)",borderRadius:10,
  border:"1px solid #EFE6D5",color:"var(--text-soft)"
});
function field(label,child){
  return el("div",{style:{display:"flex",flexDirection:"column",gap:6}},
    el("div",{style:{fontSize:11,color:"var(--text-faint)",fontWeight:600,paddingLeft:2}},label),
    child
  );
}

// ───── 메인 캘린더 ─────
function CalendarScreen(props){
  const {me,members,schedules,memos,notices,perspective,setPerspective,year,month,setYear,setMonth,onLockMode,onFullLogout,onRequestEdit} = props;
  const [showPicker,setShowPicker] = useState(false);
  const [showInputDrawer,setShowInputDrawer] = useState(false);
  const [showContacts,setShowContacts] = useState(false);
  const [showSettings,setShowSettings] = useState(false);
  const [modalDay,setModalDay] = useState(null); // {day, scrollToAll:bool}
  const [quickEditDay,setQuickEditDay] = useState(null); // 빠른 듀티 변경용
  const [showHelp,setShowHelp] = useState(false);
  const [planMode,setPlanMode] = useState(false); // 약속 잡기 모드 ON/OFF
  const [planSelectedIds,setPlanSelectedIds] = useState([]); // 약속 잡기 - 선택된 동기 ID들
  const [showPlanSheet,setShowPlanSheet] = useState(false);
  const [showNotices,setShowNotices] = useState(false);

  const isEditMode = !!me;
  const meData = me ? members[me] : null;
  const pData = perspective ? members[perspective] : null;

  // 시점 멤버가 사라졌으면 본인 또는 첫 멤버로
  useEffect(()=>{
    if(perspective && !members[perspective]){
      if(me && members[me]) setPerspective(me);
      else {
        const firstId = Object.keys(members)[0];
        setPerspective(firstId || null);
      }
    }
  },[members,perspective,me,setPerspective]);

  // 시점 좌우 스와이프
  const orderedIds = useMemo(()=>{
    return Object.entries(members)
      .sort((a,b)=>(a[1].joinedAt||0)-(b[1].joinedAt||0))
      .map(([id])=>id);
  },[members]);

  const swipePerspective = (dir)=>{
    if(orderedIds.length===0) return;
    const idx = orderedIds.indexOf(perspective);
    const next = (idx + dir + orderedIds.length) % orderedIds.length;
    setPerspective(orderedIds[next]);
  };

  // 월 이동
  const moveMonth = (dir)=>{
    let y=year, m=month+dir;
    if(m<0){y--;m=11;}
    if(m>11){y++;m=0;}
    setYear(y); setMonth(m);
  };

  // 캘린더 셀 데이터
  const daysInMonth = new Date(year,month+1,0).getDate();
  const firstDow = new Date(year,month,1).getDay();
  const cells = [];
  for(let i=0;i<firstDow;i++) cells.push(null);
  for(let d=1;d<=daysInMonth;d++) cells.push(d);
  while(cells.length%7!==0) cells.push(null);

  // ───── 스와이프 핸들러 (캘린더 본체: 월 이동) ─────
  const swipeRef = useRef({x:0,y:0,active:false});
  const onTouchStart = (e)=>{
    swipeRef.current = {
      x:e.touches[0].clientX, y:e.touches[0].clientY, active:true
    };
  };
  const onTouchEnd = (e)=>{
    if(!swipeRef.current.active) return;
    const dx = e.changedTouches[0].clientX - swipeRef.current.x;
    const dy = e.changedTouches[0].clientY - swipeRef.current.y;
    if(Math.abs(dx)>50 && Math.abs(dx)>Math.abs(dy)*1.5){
      moveMonth(dx<0 ? 1 : -1);
    }
    swipeRef.current.active = false;
  };

  // ───── 헤더 시점 카드 스와이프 핸들러 ─────
  const headerSwipeRef = useRef({x:0,y:0,active:false});
  const onHeaderTouchStart = (e)=>{
    headerSwipeRef.current = {
      x:e.touches[0].clientX, y:e.touches[0].clientY, active:true
    };
  };
  const onHeaderTouchEnd = (e)=>{
    if(!headerSwipeRef.current.active) return;
    const dx = e.changedTouches[0].clientX - headerSwipeRef.current.x;
    const dy = e.changedTouches[0].clientY - headerSwipeRef.current.y;
    if(Math.abs(dx)>40 && Math.abs(dx)>Math.abs(dy)*1.5){
      swipePerspective(dx<0 ? 1 : -1);
      headerSwipeRef.current.active = false;
      return "swiped";
    }
    headerSwipeRef.current.active = false;
  };

  if(!perspective || !pData) return el("div",{style:{padding:40,textAlign:"center",color:"var(--text-faint)"}},"로딩...");

  return el("div",{style:{minHeight:"100dvh",display:"flex",flexDirection:"column"}},
    // 헤더
    el(Header,{
      meData, pData, members, perspective, me,
      year, month,
      isEditMode,
      planMode,
      onMoveMonth:moveMonth,
      onPickPerson:()=>setShowPicker(true),
      onGoHome:()=>{ if(me) setPerspective(me); },
      onGoToday:()=>{
        const t = new Date();
        setYear(t.getFullYear());
        setMonth(t.getMonth());
      },
      onPlan:()=>setShowPlanSheet(true),
      onSettings:()=>setShowSettings(true),
      onLockMode, onRequestEdit,
      onHeaderTouchStart, onHeaderTouchEnd,
      noticeSlot: el(NoticeBar, {
        notices, members,
        onOpen: ()=>setShowNotices(true)
      })
    }),

    // 캘린더 본체 (스와이프 영역)
    el("div",{
      style:{flex:1,padding:"4px 10px 12px",touchAction:"pan-y"},
      onTouchStart, onTouchEnd
    },
      el(WeekdayRow),
      el(CalendarGrid,{
        cells, year, month, today:new Date(),
        members, schedules, memos,
        perspective, me,
        planSelectedIds,
        onCellTap:(d)=>setModalDay({day:d,scrollToAll:false}),
        onCellLongPress:(d)=>{
          if(isEditMode && perspective===me){
            setQuickEditDay(d);
          } else {
            setModalDay({day:d,scrollToAll:true});
          }
        }
      })
    ),

    // 다음 OFF 한줄평 (시점 사람 기준)
    el(NextOffPreview, { perspective, members, schedules, year, month }),

    // 입력 버튼: 수정 모드 + 본인 시점일 때만
    isEditMode && perspective===me && el("div",{style:{padding:"4px 16px 8px"}},
      el("button",{onClick:()=>setShowInputDrawer(true),
        style:{
          width:"100%",padding:"14px 16px",borderRadius:14,
          background:"var(--surface-soft)",
          color:"var(--text)",fontSize:14,fontWeight:600,
          border:"1.5px dashed #D9CCB0",
          letterSpacing:"-0.01em"
        }
      },`📝 ${year}년 ${month+1}월 듀티 한 줄 입력`)
    ),

    // 게스트 모드 안내 (본인 시점이 아닐 때는 안 띄움 - 공간 절약)
    !isEditMode && el("div",{style:{padding:"4px 16px 8px"}},
      el("button",{onClick:onRequestEdit,
        style:{
          width:"100%",padding:"12px 16px",borderRadius:14,
          background:"var(--surface-softer)",
          color:"var(--text-sub)",fontSize:13,fontWeight:600,
          border:"1px solid #EFE6D5",
          letterSpacing:"-0.01em",
          display:"flex",alignItems:"center",justifyContent:"center",gap:6
        }
      },"🔒 보기 모드 · 탭하여 수정 모드로")
    ),

    // 연락처 패널
    el(ContactsPanel,{
      open:showContacts, onToggle:()=>setShowContacts(!showContacts),
      members, me
    }),

    // 모달들
    showPicker && el(PersonPicker,{
      members, me, perspective,
      onSelect:(id)=>{setPerspective(id); setShowPicker(false);},
      onClose:()=>setShowPicker(false)
    }),
    showInputDrawer && el(InputDrawer,{
      year, month, me, members, schedules,
      onClose:()=>setShowInputDrawer(false)
    }),
    modalDay && el(DayModal,{
      day:modalDay.day, scrollToAll:modalDay.scrollToAll,
      year, month,
      members, schedules, memos,
      perspective, me, isEditMode,
      onRequestEdit,
      onChangeDay: (newY, newM, newD)=>{
        // 월/년 바뀌면 함께 업데이트
        if(newY !== year) setYear(newY);
        if(newM !== month) setMonth(newM);
        setModalDay({ day: newD, scrollToAll: false });
      },
      onClose:()=>setModalDay(null)
    }),
    showSettings && el(SettingsModal,{
      me, members, schedules, isEditMode,
      onClose:()=>setShowSettings(false),
      onLockMode, onFullLogout, onRequestEdit,
      onOpenNotices: ()=>setShowNotices(true)
    }),
    quickEditDay && el(QuickEditPopup,{
      day:quickEditDay, year, month, me, members, schedules,
      onClose:()=>setQuickEditDay(null)
    }),
    showPlanSheet && el(PlanSheet,{
      members, schedules, year, month, me, perspective,
      selectedIds: planSelectedIds,
      onChange: (ids)=>{
        setPlanSelectedIds(ids);
        setPlanMode(ids.length > 0);
      },
      onClose: ()=>setShowPlanSheet(false)
    }),
    showNotices && el(NoticesModal, {
      notices, members, me, isEditMode, onRequestEdit,
      onClose: ()=>setShowNotices(false)
    })
  );
}

// ───── 일별 공유 (SVG → PNG → Web Share) ─────
async function shareDayAsImage({day, year, month, members, schedules, memos}){
  const dow = new Date(year, month, day).getDay();
  const dowKor = ["일","월","화","수","목","금","토"];

  // 듀티별 그룹
  const groups = { D:[], E:[], N:[], O:[], custom:[] };
  Object.entries(members).forEach(([id,m])=>{
    const k = `${year}-${String(month+1).padStart(2,"0")}-${String(day).padStart(2,"0")}`;
    const s = schedules?.[id]?.[k];
    if(!s) return;
    if(["D","E","N","O"].includes(s)) groups[s].push({m, code:s});
    else groups.custom.push({m, code:s});
  });

  // 메모
  const memoEntries = Object.entries(memos||{}).sort((a,b)=>(a[1].createdAt||0)-(b[1].createdAt||0));

  // SVG 디자인
  const W = 720, padX = 40;
  const SHIFT_INFO = {
    D: { color:"#7EC8E3", light:"#E8F4FA", full:"Day", emoji:"☀️" },
    E: { color:"#8FD5A6", light:"#EAFAF0", full:"Evening", emoji:"🌆" },
    N: { color:"#F5D76E", light:"#FDF8E8", full:"Night", emoji:"🌙" },
    O: { color:"#D4A0D0", light:"#F5EAF4", full:"Off", emoji:"💤" }
  };

  let y = 56;
  let svgChunks = [];

  // 헤더
  svgChunks.push(`<text x="${padX}" y="${y}" font-family="Pretendard, -apple-system, sans-serif" font-size="22" font-weight="800" fill="#9C8F7C">🍳 monjayaki</text>`);
  y += 50;
  svgChunks.push(`<text x="${padX}" y="${y}" font-family="Pretendard, -apple-system, sans-serif" font-size="38" font-weight="800" fill="#2D2D3A">${month+1}월 ${day}일 <tspan fill="${dow===0?"#E8746E":dow===6?"#5B9BD5":"#9C8F7C"}">(${dowKor[dow]})</tspan></text>`);
  y += 24;
  svgChunks.push(`<line x1="${padX}" y1="${y}" x2="${W-padX}" y2="${y}" stroke="#E8DFCD" stroke-width="1"/>`);
  y += 30;

  // 듀티 그룹별
  ["D","E","N","O"].forEach(code=>{
    const list = groups[code];
    if(list.length===0) return;
    const info = SHIFT_INFO[code];
    const groupH = 30 + Math.ceil(list.length / 4) * 40 + 16;

    // 배경 카드
    svgChunks.push(`<rect x="${padX}" y="${y}" width="${W-padX*2}" height="${groupH}" rx="14" fill="${info.light}"/>`);

    // 헤더
    svgChunks.push(`<circle cx="${padX+22}" cy="${y+24}" r="11" fill="${info.color}"/>`);
    svgChunks.push(`<text x="${padX+22}" y="${y+29}" font-family="Pretendard, -apple-system, sans-serif" font-size="13" font-weight="800" fill="#FFFFFF" text-anchor="middle">${code}</text>`);
    svgChunks.push(`<text x="${padX+42}" y="${y+29}" font-family="Pretendard, -apple-system, sans-serif" font-size="14" font-weight="700" fill="#5C5040">${info.full} · ${list.length}명</text>`);

    // 이름들
    let nameY = y + 56;
    list.forEach((item, idx)=>{
      const col = idx % 4;
      const row = Math.floor(idx / 4);
      const cx = padX + 20 + col * ((W - padX*2 - 40) / 4);
      const cy = nameY + row * 40;
      svgChunks.push(`<rect x="${cx-8}" y="${cy-22}" width="${(W-padX*2-40)/4 - 8}" height="32" rx="16" fill="#FFFFFF"/>`);
      svgChunks.push(`<circle cx="${cx+8}" cy="${cy-6}" r="6" fill="${item.m.color || "#B8AB91"}"/>`);
      svgChunks.push(`<text x="${cx+22}" y="${cy-1}" font-family="Pretendard, -apple-system, sans-serif" font-size="14" font-weight="600" fill="#3A3A4A">${escapeXml(item.m.name)}</text>`);
    });

    y += groupH + 10;
  });

  // 커스텀 그룹
  if(groups.custom.length > 0){
    const list = groups.custom;
    const groupH = 30 + Math.ceil(list.length / 3) * 44 + 16;
    svgChunks.push(`<rect x="${padX}" y="${y}" width="${W-padX*2}" height="${groupH}" rx="14" fill="#F0EAD9"/>`);
    svgChunks.push(`<text x="${padX+22}" y="${y+28}" font-family="Pretendard, -apple-system, sans-serif" font-size="14" font-weight="700" fill="#5C5040">기타 · ${list.length}명</text>`);
    let nameY = y + 56;
    list.forEach((item, idx)=>{
      const col = idx % 3;
      const row = Math.floor(idx / 3);
      const cx = padX + 20 + col * ((W - padX*2 - 40) / 3);
      const cy = nameY + row * 44;
      svgChunks.push(`<rect x="${cx-8}" y="${cy-22}" width="${(W-padX*2-40)/3 - 8}" height="36" rx="18" fill="#FFFFFF"/>`);
      svgChunks.push(`<circle cx="${cx+10}" cy="${cy-4}" r="10" fill="${item.m.color || "#B8AB91"}"/>`);
      svgChunks.push(`<text x="${cx+10}" y="${cy}" font-family="Pretendard, -apple-system, sans-serif" font-size="11" font-weight="800" fill="#FFFFFF" text-anchor="middle">${item.code}</text>`);
      svgChunks.push(`<text x="${cx+26}" y="${cy+1}" font-family="Pretendard, -apple-system, sans-serif" font-size="14" font-weight="600" fill="#3A3A4A">${escapeXml(item.m.name)}</text>`);
    });
    y += groupH + 10;
  }

  // 메모
  if(memoEntries.length > 0){
    y += 8;
    svgChunks.push(`<text x="${padX}" y="${y}" font-family="Pretendard, -apple-system, sans-serif" font-size="13" font-weight="700" fill="#9C8F7C">📝 메모</text>`);
    y += 12;
    memoEntries.forEach(([mid,memo])=>{
      const author = members[memo.authorId];
      const text = `${memo.emoji||"📌"} ${memo.text}`;
      svgChunks.push(`<rect x="${padX}" y="${y}" width="${W-padX*2}" height="48" rx="12" fill="#FFFFFF"/>`);
      svgChunks.push(`<text x="${padX+16}" y="${y+22}" font-family="Pretendard, -apple-system, sans-serif" font-size="14" font-weight="600" fill="#3A3A4A">${escapeXml(text.slice(0,40))}</text>`);
      svgChunks.push(`<text x="${padX+16}" y="${y+40}" font-family="Pretendard, -apple-system, sans-serif" font-size="11" font-weight="500" fill="#9C8F7C">— ${escapeXml(author?.name||"?")}</text>`);
      y += 56;
    });
  }

  y += 30;
  const H = y;

  const svg = `<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="${W}" height="${H}" viewBox="0 0 ${W} ${H}">
<rect width="${W}" height="${H}" fill="#FAF7F0"/>
${svgChunks.join("\n")}
</svg>`;

  // SVG → PNG (Canvas 변환)
  try {
    const blob = await svgToPngBlob(svg, W, H);
    const file = new File([blob], `monjayaki-${month+1}-${day}.png`, { type:"image/png" });

    if(navigator.canShare && navigator.canShare({ files:[file] })){
      await navigator.share({ files:[file] });
    } else if(navigator.share){
      // 파일 공유 미지원 → 텍스트 폴백
      const text = makeDayShareText({day, year, month, members, schedules, memos});
      await navigator.share({ text });
    } else {
      // Web Share 자체 미지원 → PNG 다운로드
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `monjayaki-${month+1}-${day}.png`;
      a.click();
      URL.revokeObjectURL(url);
    }
  } catch(e){
    console.error("share failed", e);
    // 폴백: 텍스트 복사
    const text = makeDayShareText({day, year, month, members, schedules, memos});
    try {
      await navigator.clipboard.writeText(text);
      alert("이미지 공유 실패. 텍스트로 클립보드에 복사됨.");
    } catch(e2){
      alert("공유 실패: " + e.message);
    }
  }
}

function escapeXml(s){
  return String(s||"").replace(/[<>&'"]/g, c => ({
    "<":"&lt;",">":"&gt;","&":"&amp;","'":"&apos;",'"':"&quot;"
  })[c]);
}

function svgToPngBlob(svg, w, h){
  return new Promise((resolve,reject)=>{
    const blob = new Blob([svg], { type:"image/svg+xml;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const img = new Image();
    img.onload = ()=>{
      const canvas = document.createElement("canvas");
      const scale = 2;
      canvas.width = w * scale;
      canvas.height = h * scale;
      const ctx = canvas.getContext("2d");
      ctx.fillStyle = "#FAF7F0";
      ctx.fillRect(0,0,canvas.width, canvas.height);
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      URL.revokeObjectURL(url);
      canvas.toBlob(b => b ? resolve(b) : reject(new Error("toBlob failed")), "image/png");
    };
    img.onerror = (e)=>{ URL.revokeObjectURL(url); reject(new Error("img load failed")); };
    img.src = url;
  });
}

function makeDayShareText({day, year, month, members, schedules, memos}){
  const dowKor = ["일","월","화","수","목","금","토"];
  const dow = new Date(year, month, day).getDay();
  const groups = { D:[], E:[], N:[], O:[], custom:[] };
  Object.entries(members).forEach(([id,m])=>{
    const k = `${year}-${String(month+1).padStart(2,"0")}-${String(day).padStart(2,"0")}`;
    const s = schedules?.[id]?.[k];
    if(!s) return;
    if(["D","E","N","O"].includes(s)) groups[s].push(m.name);
    else groups.custom.push(`${m.name}(${s})`);
  });
  const labels = { D:"☀️ Day", E:"🌆 Evening", N:"🌙 Night", O:"💤 Off" };
  let text = `📅 ${month+1}월 ${day}일 (${dowKor[dow]})\n\n`;
  ["D","E","N","O"].forEach(c=>{
    if(groups[c].length>0){
      text += `${labels[c]} (${groups[c].length})\n${groups[c].join(", ")}\n\n`;
    }
  });
  if(groups.custom.length>0){
    text += `기타 (${groups.custom.length})\n${groups.custom.join(", ")}\n\n`;
  }
  return text.trim();
}

// ───── 다음 OFF 한줄평 ─────
function NextOffPreview({perspective,members,schedules,year,month}){
  const info = useMemo(()=>{
    if(!perspective) return null;
    const mySchedule = schedules?.[perspective] || {};
    const today = new Date();
    today.setHours(0,0,0,0);

    // 이번 달 끝까지 검색
    const lastDay = new Date(year, month+1, 0);
    let nextOffDate = null;
    let cursor = new Date(today);
    if(cursor.getFullYear()!==year || cursor.getMonth()!==month){
      // 다른 월 보고 있으면 그 월 1일부터
      cursor = new Date(year, month, 1);
    }
    while(cursor <= lastDay){
      const k = dKey(cursor.getFullYear(), cursor.getMonth(), cursor.getDate());
      if(mySchedule[k]==="O"){
        nextOffDate = new Date(cursor);
        break;
      }
      cursor.setDate(cursor.getDate()+1);
    }

    if(!nextOffDate) return { type:"none" };

    // 그날 같이 OFF인 다른 사람들
    const k = dKey(nextOffDate.getFullYear(), nextOffDate.getMonth(), nextOffDate.getDate());
    const sameOff = [];
    Object.entries(members).forEach(([id,m])=>{
      if(id===perspective) return;
      if(schedules?.[id]?.[k]==="O") sameOff.push(m.name);
    });

    return {
      type: sameOff.length===0 ? "alone"
          : sameOff.length<=3 ? "few"
          : "many",
      date: `${nextOffDate.getMonth()+1}/${nextOffDate.getDate()}`,
      names: sameOff,
      count: sameOff.length
    };
  },[perspective,members,schedules,year,month]);

  if(!info) return null;

  let text = "";
  if(info.type==="none") text = "이번 달 남은 OFF가 없어요";
  else if(info.type==="alone") text = `다음 오프(${info.date})에는 혼자 쉬는 날이에요`;
  else if(info.type==="few") text = `다음 오프(${info.date})에 ${info.names.join(", ")}도 같이 쉬네요`;
  else text = `다음 오프(${info.date})에 ${info.count}명이나 같이 쉬네요`;

  return el("div",{style:{
    padding:"8px 18px 4px",
    fontSize:12, color:"var(--text-faint)", fontWeight:600,
    letterSpacing:"-0.01em", textAlign:"center"
  }}, text);
}

