// ───── 캘린더 그리드 ─────
function CalendarGrid({cells,year,month,today,members,schedules,memos,perspective,me,planSelectedIds,onCellTap,onCellLongPress}){
  const longPressRef = useRef({timer:null,fired:false});

  const startPress = (day)=>{
    longPressRef.current.fired = false;
    longPressRef.current.timer = setTimeout(()=>{
      longPressRef.current.fired = true;
      if(navigator.vibrate) navigator.vibrate(15);
      onCellLongPress(day);
    },420);
  };
  const endPress = (day)=>{
    if(longPressRef.current.timer){
      clearTimeout(longPressRef.current.timer);
      longPressRef.current.timer = null;
    }
    if(!longPressRef.current.fired) onCellTap(day);
    longPressRef.current.fired = false;
  };
  const cancelPress = ()=>{
    if(longPressRef.current.timer){
      clearTimeout(longPressRef.current.timer);
      longPressRef.current.timer = null;
    }
    longPressRef.current.fired = true;
  };

  return el("div",{style:{display:"grid",gridTemplateColumns:"repeat(7,1fr)",gap:3}},
    cells.map((d,idx)=>{
      if(d===null) return el("div",{key:`e${idx}`,style:{aspectRatio:"1/1.15"}});
      return el(DayCell,{
        key:d, day:d, year, month, today,
        dow:idx%7,
        members, schedules, memos, perspective,
        planSelectedIds,
        onPressStart:()=>startPress(d),
        onPressEnd:()=>endPress(d),
        onPressCancel:cancelPress
      });
    })
  );
}

// ───── 한 셀 ─────
function DayCell({day,year,month,today,dow,members,schedules,memos,perspective,planSelectedIds,onPressStart,onPressEnd,onPressCancel}){
  const dateKey = dKey(year,month,day);
  const isToday = today.getFullYear()===year && today.getMonth()===month && today.getDate()===day;

  const pData = members[perspective];
  const myShift = schedules?.[perspective]?.[dateKey] || null;
  const sInfo = myShift && SHIFT[myShift] ? SHIFT[myShift] : null;
  const isCustom = myShift && !RESERVED_CODES.includes(myShift);

  // 통계 계산
  const counts = useMemo(()=>{
    const c = {D:0,E:0,N:0,O:0};
    Object.keys(members).forEach(mid=>{
      const s = schedules?.[mid]?.[dateKey];
      if(s && c[s]!==undefined) c[s]++;
    });
    return c;
  },[members,schedules,dateKey]);

  const sameCount = sInfo && (myShift!=="O") ? counts[myShift]-1 : 0;

  // 메모 존재 여부
  const hasMemo = memos[dateKey] && Object.keys(memos[dateKey]).length>0;

  // 생일
  const birthdays = useMemo(()=>{
    return Object.values(members).filter(m=>m.birthMonth===month+1 && m.birthDay===day);
  },[members,month,day]);

  // 약속 잡기 모드: 3가지 상황 강조
  // - "off": 선택자 전원 OFF (가장 추천)
  // - "d": 선택자 전원 D (퇴근 후 약속 가능, 다음 날 무관)
  // - "e": 선택자 전원 E + 다음 날 전원 OFF (이브닝 끝나고 늦게까지)
  const planMatch = useMemo(()=>{
    if(!planSelectedIds || planSelectedIds.length===0) return null;

    // 1. 모두 OFF
    let allOff = true;
    for(const id of planSelectedIds){
      if(schedules?.[id]?.[dateKey] !== "O"){ allOff = false; break; }
    }
    if(allOff) return "off";

    // 2. 모두 D (다음 날 조건 없음)
    let allD = true;
    for(const id of planSelectedIds){
      if(schedules?.[id]?.[dateKey] !== "D"){ allD = false; break; }
    }
    if(allD) return "d";

    // 3. 모두 E + 다음 날 모두 OFF 또는 N
    let allE = true;
    for(const id of planSelectedIds){
      if(schedules?.[id]?.[dateKey] !== "E"){ allE = false; break; }
    }
    if(allE){
      const nextDate = new Date(year, month, day+1);
      const nextKey = dKey(nextDate.getFullYear(), nextDate.getMonth(), nextDate.getDate());
      let allOffOrN = true;
      for(const id of planSelectedIds){
        const s = schedules?.[id]?.[nextKey];
        if(s !== "O" && s !== "N"){ allOffOrN = false; break; }
      }
      if(allOffOrN) return "e";
    }

    return null;
  },[planSelectedIds,schedules,dateKey,year,month,day]);

  // 셀 색상
  let bg = "var(--surface-softer)";
  let cellBorder = "1px solid var(--border)";
  if(isToday){
    cellBorder = `2px solid ${pData.color}`;
  }
  if(planSelectedIds && planSelectedIds.length>0){
    if(planMatch === "off"){
      bg = "var(--shift-o-light)";
      cellBorder = "2px solid var(--shift-o)";
    } else if(planMatch === "d"){
      bg = "var(--shift-d-light)";
      cellBorder = "2px solid var(--shift-d)";
    } else if(planMatch === "e"){
      bg = "var(--shift-e-light)";
      cellBorder = "2px solid var(--shift-e)";
    } else {
      bg = "var(--surface-softer)";
    }
  }
  const isDimmed = planSelectedIds && planSelectedIds.length>0 && !planMatch;

  const dowColor = dow===0?"var(--sun)":dow===6?"var(--sat)":"var(--text-sub)";

  return el("div",{
    onTouchStart:onPressStart, onTouchEnd:onPressEnd, onTouchMove:onPressCancel, onTouchCancel:onPressCancel,
    onMouseDown:onPressStart, onMouseUp:onPressEnd, onMouseLeave:onPressCancel,
    style:{
      position:"relative",
      aspectRatio:"1/1.15",
      background:bg,
      border:cellBorder,
      borderRadius:9,
      padding:"3px 3px 2px",
      display:"flex",flexDirection:"column",
      cursor:"pointer",
      overflow:"hidden",
      opacity: isDimmed ? 0.35 : 1,
      transition: "opacity 0.18s, background 0.18s"
    }
  },
    // 좌상단: 메모점
    hasMemo && el("div",{style:{
      position:"absolute",top:3,left:3,
      width:6,height:6,borderRadius:"50%",
      background:MEMO_COLOR,
      boxShadow:"0 0 0 1.5px rgba(255,255,255,0.9)"
    }}),
    // 우상단: 생일
    birthdays.length>0 && el("div",{style:{
      position:"absolute",top:1,right:2,fontSize:9
    }},"🎂"),
    // 날짜
    el("div",{style:{
      fontSize:10,fontWeight:700,color:dowColor,
      textAlign:"center",lineHeight:1,marginTop:1
    }},day),
    // 듀티
    el("div",{style:{
      flex:1,display:"flex",alignItems:"center",justifyContent:"center"
    }},
      sInfo
        ? el("div",{style:{
            fontSize:18,fontWeight:800,color:sInfo.color,letterSpacing:"-0.02em",lineHeight:1
          }},sInfo.label)
        : isCustom
          ? el("div",{style:{
              fontSize:16,fontWeight:800,color:"var(--text-sub)",letterSpacing:"-0.02em",lineHeight:1
            }},myShift)
          : el("div",{style:{fontSize:11,color:"var(--text-extrafaint)"}},"·")
    ),
    // 하단 통계 (항상 O · D · E · N 4개)
    el("div",{style:{
      display:"flex",justifyContent:"center",alignItems:"center",
      gap:2,
      paddingBottom:1,minHeight:11
    }},
      statMini(counts.O, SHIFT.O.color),
      sep(),
      statMini(counts.D, SHIFT.D.color),
      sep(),
      statMini(counts.E, SHIFT.E.color),
      sep(),
      statMini(counts.N, SHIFT.N.color)
    )
  );
}

