const REACTION_EMOJIS = ["👍","🎉","❤️","🍻","😂","🙌"];

function MemoReactions({dateKey,mid,reactions,members,me,isEditMode,onRequestEdit}){
  const [pickerOpen,setPickerOpen] = useState(false);

  // reactions: { emoji: { userId: true } }
  const summary = useMemo(()=>{
    const arr = [];
    Object.entries(reactions||{}).forEach(([emoji, users])=>{
      const userIds = Object.keys(users||{}).filter(uid => users[uid] && members[uid]);
      if(userIds.length>0){
        arr.push({ emoji, userIds, count: userIds.length, mineActive: !!(me && users[me]) });
      }
    });
    // 많이 받은 순 정렬
    arr.sort((a,b)=>b.count-a.count);
    return arr;
  },[reactions,members,me]);

  const toggleReaction = async(emoji)=>{
    if(!isEditMode){
      onRequestEdit && onRequestEdit();
      return;
    }
    const path = `${ROOT}/memos/${dateKey}/${mid}/reactions/${emoji}/${me}`;
    const cur = reactions?.[emoji]?.[me];
    if(cur) await set(ref(db,path), null);
    else await set(ref(db,path), true);
    setPickerOpen(false);
  };

  return el("div",{style:{display:"flex",alignItems:"center",gap:4,flexWrap:"wrap"}},
    summary.map(({emoji,userIds,count,mineActive})=>
      el("button",{key:emoji, onClick:()=>toggleReaction(emoji),
        title: userIds.map(uid=>members[uid]?.name).filter(Boolean).join(", "),
        style:{
          display:"inline-flex",alignItems:"center",gap:3,
          padding:"3px 8px",borderRadius:12,
          background: mineActive ? "var(--shift-d-light)" : "var(--surface-faint)",
          border: `1px solid ${mineActive ? "var(--shift-d)" : "var(--border)"}`,
          fontSize:12, lineHeight:1
        }
      },
        el("span",null, emoji),
        el("span",{style:{fontSize:11,fontWeight:600,color:"var(--text-sub)"}}, count)
      )
    ),
    pickerOpen
      ? el("div",{style:{display:"inline-flex",alignItems:"center",gap:2,padding:"3px 6px",borderRadius:12,background:"var(--surface-faint)",border:"1px solid var(--border)"}},
          REACTION_EMOJIS.map(em=>el("button",{key:em,onClick:()=>toggleReaction(em),
            style:{fontSize:14,padding:"2px 4px",lineHeight:1}}, em))
        )
      : el("button",{onClick:()=>{
          if(!isEditMode){ onRequestEdit && onRequestEdit(); return; }
          setPickerOpen(true);
        },
        style:{
          padding:"3px 8px",borderRadius:12,
          background:"transparent",
          border:"1px dashed var(--border-soft)",
          fontSize:11, color:"var(--text-fainter)", lineHeight:1
        }
      }, summary.length===0 ? "+ 반응" : "+")
  );
}

