// ───── 상수 ─────
const el = React.createElement;
const {useState, useEffect, useMemo, useRef, useCallback} = React;

const WEEKDAYS = ["일","월","화","수","목","금","토"];
const SHIFT = {
  D:{label:"D",full:"데이",color:"var(--shift-d)",light:"var(--shift-d-light)"},
  E:{label:"E",full:"이브닝",color:"var(--shift-e)",light:"var(--shift-e-light)"},
  N:{label:"N",full:"나이트",color:"var(--shift-n)",light:"var(--shift-n-light)"},
  O:{label:"O",full:"오프",color:"var(--shift-o)",light:"var(--shift-o-light)"},
};
const RESERVED_CODES = ["D","E","N","O"];

const MEMBER_COLORS = [
  // 블루 계열
  "var(--sat)","#3D7AB8","#7AB8E0","#4A6FA5","#6BA8C7",
  // 퍼플 계열
  "#9B6FB5","#C07ABC","#7E5BA0","#B58FCB","#8B6FA8",
  // 레드/핑크 계열
  "var(--sun)","#D85A8E","#C66575","#E89399","#B85770",
  // 오렌지/옐로우 계열
  "#F5A623","#E8954D","#D8A85C","#C99060","#E0B870",
  // 그린 계열
  "#6FB89B","#7BA98F","#8FBE73","#5A9B8A","#9BC78E",
  // 브라운/얼스 계열
  "#B89B6E","#B47B5C","#A88660","#9C7050","#C49475"
];

const MEMO_COLOR = "var(--memo)";
const NEUTRAL_COLOR = "var(--neutral)";
const NEUTRAL_LIGHT = "var(--neutral-light)";
const MAX_MEMBERS = 14;

const dKey = (y,m,d) => `${y}-${String(m+1).padStart(2,"0")}-${String(d).padStart(2,"0")}`;

// 전화번호 자동 하이픈
function formatPhone(digits){
  const d = (digits||"").replace(/\D/g,"");
  if(d.length<4) return d;
  if(d.length<7) return `${d.slice(0,3)}-${d.slice(3)}`;
  if(d.length<11) return `${d.slice(0,3)}-${d.slice(3,6)}-${d.slice(6)}`;
  return `${d.slice(0,3)}-${d.slice(3,7)}-${d.slice(7,11)}`;
}

// ───── 메인 앱 ─────
function App(){
  const [view,setView] = useState("loading"); // loading | auth | main
  const [authMode,setAuthMode] = useState("login"); // login | signup
  const [me,setMe] = useState(null); // 인증된 memberId (수정 모드일 때만 값 있음)
  const [members,setMembers] = useState({});
  const [schedules,setSchedules] = useState({});
  const [memos,setMemos] = useState({});
  const [notices,setNotices] = useState({});
  const [perspective,setPerspective] = useState(null); // 보는 시점 memberId
  const today = new Date();
  const [year,setYear] = useState(today.getFullYear());
  const [month,setMonth] = useState(today.getMonth());

  const [showLoginModal,setShowLoginModal] = useState(false); // 수정 모드 진입 모달

  // ?view=이름 URL 파라미터 처리 + sessionStorage 복원
  useEffect(()=>{
    const params = new URLSearchParams(window.location.search);
    const viewParam = params.get("view");

    // sessionStorage에서 인증 상태 복원
    const savedId = sessionStorage.getItem("group_duty_me");

    if(savedId){
      // 이전에 수정 모드로 인증한 상태 (창 닫지 않음)
      setMe(savedId);
      if(!viewParam) setPerspective(savedId);
      setView("main");
    } else if(viewParam){
      // 위젯 등에서 ?view=이름 으로 진입 → 게스트 모드로 캘린더 직진입
      // perspective는 members 로드 후 설정 (아래 effect에서)
      setView("main");
    } else {
      // 직접 링크 진입 → 로그인 강제
      setView("auth");
    }
  },[]);

  // ?view= 파라미터로 진입한 경우, members 로드되면 해당 사람으로 시점 설정
  useEffect(()=>{
    if(view!=="main" || perspective) return;
    const params = new URLSearchParams(window.location.search);
    const viewParam = params.get("view");
    if(!viewParam) return;
    const matchId = Object.entries(members).find(([id,m])=>m.name===viewParam.trim())?.[0];
    if(matchId){
      setPerspective(matchId);
    } else if(Object.keys(members).length > 0){
      // 이름 매칭 안 되면 첫 멤버로
      const firstId = Object.entries(members).sort((a,b)=>(a[1].joinedAt||0)-(b[1].joinedAt||0))[0]?.[0];
      if(firstId) setPerspective(firstId);
    }
  },[members,view,perspective]);

  // Firebase 리스너
  useEffect(()=>{
    const unsubM = onValue(ref(db,`${ROOT}/members`), s=>{
      setMembers(s.val()||{});
    });
    const unsubS = onValue(ref(db,`${ROOT}/schedules`), s=>{
      setSchedules(s.val()||{});
    });
    const unsubMe = onValue(ref(db,`${ROOT}/memos`), s=>{
      setMemos(s.val()||{});
    });
    const unsubN = onValue(ref(db,`${ROOT}/notices`), s=>{
      setNotices(s.val()||{});
    });
    return ()=>{ unsubM(); unsubS(); unsubMe(); unsubN(); };
  },[]);

  // 수정 모드 진입 (auth 화면에서 가입/로그인 또는 본 화면에서 잠금 해제)
  const handleLogin = useCallback((memberId)=>{
    sessionStorage.setItem("group_duty_me", memberId);
    setMe(memberId);
    setPerspective(p => p || memberId);
    setView("main");
    setShowLoginModal(false);
  },[]);

  // 수정 모드 종료 = 잠금 (게스트로 복귀, 시점은 유지)
  const handleLockMode = useCallback(()=>{
    sessionStorage.removeItem("group_duty_me");
    setMe(null);
    // perspective는 그대로 유지 (보기는 가능)
  },[]);

  // 완전 로그아웃 (auth 화면으로 — 거의 안 쓰임, 비상시용)
  const handleFullLogout = useCallback(()=>{
    sessionStorage.removeItem("group_duty_me");
    setMe(null);
    setPerspective(null);
    setView("auth");
  },[]);

  if(view==="loading"){
    return el("div",{style:{display:"flex",alignItems:"center",justifyContent:"center",height:"100dvh",color:"var(--text-faint)"}},"...");
  }
  if(view==="auth"){
    return el(AuthScreen,{
      mode:authMode, setMode:setAuthMode,
      members, onLogin:handleLogin
    });
  }
  return el(React.Fragment, null,
    el(CalendarScreen,{
      me, members, schedules, memos, notices,
      perspective, setPerspective,
      year, month, setYear, setMonth,
      onLockMode:handleLockMode,
      onFullLogout:handleFullLogout,
      onRequestEdit:()=>setShowLoginModal(true)
    }),
    showLoginModal && el(EditModeLoginModal,{
      members,
      onLogin:handleLogin,
      onClose:()=>setShowLoginModal(false)
    })
  );
}

// ───── 수정 모드 진입 모달 (수정 모드로 들어가려고 비번 입력) ─────
function EditModeLoginModal({members,onLogin,onClose}){
  const [selectedId,setSelectedId] = useState("");
  const [pw,setPw] = useState("");
  const [err,setErr] = useState("");
  const memberList = Object.entries(members).sort((a,b)=>(a[1].joinedAt||0)-(b[1].joinedAt||0));

  const handleSubmit = ()=>{
    if(!selectedId) return setErr("이름을 선택해");
    if(pw.length!==4) return setErr("비번 4자리");
    if(members[selectedId].password!==pw) return setErr("비번 틀림");
    setErr("");
    onLogin(selectedId);
  };

  return el("div",{className:"anim-fade",
    onClick:onClose,
    style:{
      position:"fixed",inset:0,background:"var(--modal-bg)",
      zIndex:90,display:"flex",alignItems:"flex-end"
    }
  },
    el("div",{className:"anim-up",
      onClick:e=>e.stopPropagation(),
      style:{
        width:"100%",background:"var(--bg-1)",
        borderRadius:"22px 22px 0 0",
        padding:"22px 18px 28px",
        maxHeight:"80vh",overflowY:"auto"
      }
    },
      el("div",{style:{width:36,height:4,background:"var(--border-soft)",borderRadius:2,margin:"0 auto 14px"}}),
      el("div",{style:{fontSize:18,fontWeight:800,marginBottom:6,color:"var(--text)"}},"🔓 수정 모드 진입"),
      el("div",{style:{fontSize:12,color:"var(--text-faint)",marginBottom:14,lineHeight:1.5}},
        "본인 인증 후 듀티 입력, 메모 작성, 정보 수정이 가능해져요."),
      el("div",{style:{background:"var(--surface-softer)",borderRadius:14,padding:"4px 6px",marginBottom:12}},
        el("div",{style:{padding:"4px 12px 0",fontSize:11,color:"var(--text-faint)",fontWeight:600}},"이름"),
        memberList.length===0
          ? el("div",{style:{padding:"14px 12px",fontSize:14,color:"var(--text-fainter)"}},"가입된 멤버가 없어요.")
          : el("div",{style:{display:"flex",flexWrap:"wrap",gap:6,padding:"8px 8px 10px"}},
            memberList.map(([id,m])=>
              el("button",{key:id,onClick:()=>setSelectedId(id),
                style:{
                  padding:"7px 12px",borderRadius:20,
                  background:selectedId===id?m.color:"var(--surface)",
                  color:selectedId===id?"var(--surface)":"var(--text-soft)",
                  fontSize:13,fontWeight:selectedId===id?700:500,
                  border:`1.5px solid ${selectedId===id?m.color:"var(--border)"}`
                }
              },m.name)
            )
          )
      ),
      el("div",{style:{background:"var(--surface-softer)",borderRadius:14,padding:"14px 16px",marginBottom:10}},
        el("div",{style:{fontSize:11,color:"var(--text-faint)",fontWeight:600,marginBottom:8}},"비밀번호 4자리"),
        el("input",{
          type:"tel",inputMode:"numeric",pattern:"[0-9]*",maxLength:4,
          value:pw,onChange:e=>setPw(e.target.value.replace(/\D/g,"").slice(0,4)),
          placeholder:"••••",
          style:{width:"100%",fontSize:22,letterSpacing:"0.5em",fontWeight:700,textAlign:"center",color:"var(--text-soft)",padding:"4px 0"}
        })
      ),
      err && el("div",{style:{fontSize:13,color:MEMO_COLOR,textAlign:"center",marginBottom:8}},err),
      el("div",{style:{display:"flex",gap:8,marginTop:8}},
        el("button",{onClick:onClose,
          style:{flex:1,padding:"14px 0",borderRadius:12,background:"var(--surface)",border:"1px solid #EFE6D5",color:"var(--text-sub)",fontSize:14,fontWeight:600}
        },"취소"),
        el("button",{onClick:handleSubmit,
          style:{flex:2,padding:"14px 0",borderRadius:12,background:"var(--text)",color:"var(--surface)",fontSize:14,fontWeight:700}
        },"잠금 해제")
      )
    )
  );
}

// ───── 인증 화면 ─────
