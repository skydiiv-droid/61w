        ),
        editingCode ? el("div",null,
          el("div",{style:{display:"flex",gap:8,marginBottom:8}},
            el("input",{type:"text",value:code,
              onChange:e=>setCode(e.target.value.toUpperCase().slice(0,1)),
              placeholder:"I",maxLength:1,
              style:{...inputStyle(),width:60,textAlign:"center",fontSize:18,fontWeight:800}
            }),
            el("input",{type:"text",value:desc,
              onChange:e=>setDesc(e.target.value.slice(0,30)),
              placeholder:"예: 8am~6pm 상근",
              style:{...inputStyle(),flex:1}
            })
          ),
          err && el("div",{style:{fontSize:12,color:MEMO_COLOR,marginBottom:8}},err),
          el("div",{style:{display:"flex",gap:6}},
            el("button",{onClick:()=>{setEditingCode(false);setErr("");setCode(meData?.customCode||"");setDesc(meData?.customDesc||"");},
              style:{flex:1,padding:"10px 0",borderRadius:10,background:"var(--surface-faint)",fontSize:13,color:"var(--text-sub)",fontWeight:600}
            },"취소"),
            el("button",{onClick:saveCode,
              style:{flex:2,padding:"10px 0",borderRadius:10,background:"var(--text)",color:"var(--surface)",fontSize:13,fontWeight:700}
            },"저장")
          )
        ) : el("button",{onClick:()=>setEditingCode(true),
          style:{
            width:"100%",padding:"12px",borderRadius:10,
            background:"var(--surface-faint)",fontSize:14,color:"var(--text-soft)",fontWeight:600,
            display:"flex",alignItems:"center",justifyContent:"space-between"
          }
        },
          el("span",null, meData?.customCode ? `${meData.customCode} = ${meData.customDesc||""}` : "코드 추가"),
          el("span",{style:{color:"var(--text-faint)"}},"›")
        ),
        usedCodes.size>0 && el("div",{style:{fontSize:10,color:"var(--text-fainter)",marginTop:8}},
          `다른 멤버 사용 중: ${Array.from(usedCodes).join(", ")}`
        )
      ),

      // 수정 모드: 잠금 (수정 모드 종료)
      isEditMode && el("button",{onClick:()=>{onClose();onLockMode();},
        style:{
          width:"100%",padding:"14px 0",borderRadius:12,
          background:"var(--surface)",border:"1px solid #EFE6D5",
          color:"var(--text-sub)",fontSize:14,fontWeight:700,marginBottom:10
        }
      },"🔒 수정 모드 종료"),

      // 수정 모드: 계정 삭제
      isEditMode && el("button",{onClick:()=>setShowDelete(true),
        style:{
          width:"100%",padding:"14px 0",borderRadius:12,
          background:"transparent",border:"1px solid rgba(255,92,92,0.3)",
          color:MEMO_COLOR,fontSize:13,fontWeight:600,marginBottom:8
        }
      },"계정 삭제"),

      isEditMode && el("div",{style:{fontSize:10,color:"var(--text-fainter)",textAlign:"center",marginTop:6}},
        "창을 닫거나 잠금 시 게스트 모드로 돌아가요. 데이터는 보존됨."),

      // 프로필 수정 모달
      showProfile && meData && el(ProfileEditor,{
        me, meData, members,
        onClose:()=>setShowProfile(false)
      }),
      // 계정 삭제 모달
      showDelete && meData && el(DeleteAccount,{
        me, meData,
        onClose:()=>setShowDelete(false),
        onDeleted:onFullLogout
      }),
      // 사용법 모달
      showHelp && el(HelpModal, { onClose:()=>setShowHelp(false) })
    )
  );
}

