function DayModal({day,scrollToAll,year,month,members,schedules,memos,perspective,me,isEditMode,onRequestEdit,onChangeDay,onClose}){
  const dateKey = dKey(year,month,day);
  const dow = new Date(year,month,day).getDay();
  const allRef = useRef(null);
  const isMyView = isEditMode && perspective===me;
  const [editingDuty,setEditingDuty] = useState(false);

  // 일자 변경 (좌우 스와이프용)
  const goPrevDay = useCallback(()=>{
    if(!onChangeDay) return;
    const d = new Date(year, month, day-1);
    onChangeDay(d.getFullYear(), d.getMonth(), d.getDate());
  },[year,month,day,onChangeDay]);

  const goNextDay = useCallback(()=>{
    if(!onChangeDay) return;
    const d = new Date(year, month, day+1);
    onChangeDay(d.getFullYear(), d.getMonth(), d.getDate());
  },[year,month,day,onChangeDay]);

  // 스와이프 감지 (모달 본문 내부)
  const swipeRef = useRef({startX:0, startY:0, startTime:0});
  const onContentTouchStart = (e)=>{
    if(!e.touches || !e.touches[0]) return;
    swipeRef.current = {
      startX: e.touches[0].clientX,
      startY: e.touches[0].clientY,
      startTime: Date.now()
    };
  };
  const onContentTouchEnd = (e)=>{
    if(!e.changedTouches || !e.changedTouches[0]) return;
    const dx = e.changedTouches[0].clientX - swipeRef.current.startX;
    const dy = e.changedTouches[0].clientY - swipeRef.current.startY;
    const dt = Date.now() - swipeRef.current.startTime;
    // 빠르고(<500ms) 충분히 가로(>50px)이고 세로보다 우세
    if(dt < 500 && Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5){
      if(dx > 0) goPrevDay();
      else goNextDay();
    }
  };

  useEffect(()=>{
    if(scrollToAll && allRef.current){
      setTimeout(()=>allRef.current.scrollIntoView({behavior:"smooth",block:"start"}),200);
    }
  },[scrollToAll]);

  // 듀티별 그룹
  const groups = useMemo(()=>{
    const g = {D:[],E:[],N:[],O:[],custom:[]};
    Object.entries(members).forEach(([id,m])=>{
      const s = schedules?.[id]?.[dateKey];
      if(!s) return;
      if(RESERVED_CODES.includes(s)) g[s].push({id,m,code:s});
      else g.custom.push({id,m,code:s});
    });
    return g;
  },[members,schedules,dateKey]);

  // 메모
  const dayMemos = memos[dateKey] || {};
  const memoEntries = Object.entries(dayMemos).sort((a,b)=>(a[1].createdAt||0)-(b[1].createdAt||0));

  // 생일
  const birthdays = Object.values(members).filter(m=>m.birthMonth===month+1 && m.birthDay===day);

  return el("div",{className:"anim-fade",
    onClick:onClose,
    style:{
      position:"fixed",inset:0,background:"var(--modal-bg)",
      zIndex:60,display:"flex",alignItems:"flex-end"
    }
  },
    el("div",{className:"anim-up",
      onClick:e=>e.stopPropagation(),
      onTouchStart:onContentTouchStart,
      onTouchEnd:onContentTouchEnd,
      style:{
        width:"100%",background:"var(--bg-1)",
        borderRadius:"22px 22px 0 0",
        maxHeight:"86vh",overflowY:"auto",
        padding:"20px 18px 32px"
