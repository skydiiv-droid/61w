function InputDrawer({year,month,me,members,schedules,onClose}){
  const [text,setText] = useState("");
  const [err,setErr] = useState("");
  const [saving,setSaving] = useState(false);

  const meData = members[me];
  const customCode = meData?.customCode;
  const customDesc = meData?.customDesc;
  const daysInMonth = new Date(year,month+1,0).getDate();

  // 기존 듀티 한 줄로 미리 채우기
  useEffect(()=>{
    let s = "";
    for(let d=1;d<=daysInMonth;d++){
      s += schedules?.[me]?.[dKey(year,month,d)] || "_";
    }
    setText(s);
  },[year,month,me,schedules,daysInMonth]);

  const validChars = ["D","E","N","O","_",customCode].filter(Boolean);

  const handleSave = async()=>{
    const cleaned = text.toUpperCase().replace(/\s/g,"");
    if(cleaned.length!==daysInMonth){
      return setErr(`${daysInMonth}자가 필요해. 현재 ${cleaned.length}자`);
    }
    for(let i=0;i<cleaned.length;i++){
      if(!validChars.includes(cleaned[i])){
        return setErr(`${i+1}일: "${cleaned[i]}"는 허용 안 됨`);
      }
    }
    setErr(""); setSaving(true);
    const updates = {};
    for(let d=1;d<=daysInMonth;d++){
      const c = cleaned[d-1];
      const k = `${ROOT}/schedules/${me}/${dKey(year,month,d)}`;
      updates[k] = c==="_" ? null : c;
    }
    await update(ref(db),updates);
    setSaving(false);
    onClose();
  };

  return el("div",{className:"anim-fade",
    onClick:onClose,
    style:{
      position:"fixed",inset:0,background:"var(--modal-bg)",
      zIndex:50,display:"flex",alignItems:"flex-end"
    }
  },
    el("div",{className:"anim-up",
      onClick:e=>e.stopPropagation(),
      style:{
        width:"100%",background:"var(--bg-1)",
        borderRadius:"22px 22px 0 0",
        padding:"20px 18px 24px"
      }
    },
      el("div",{style:{width:36,height:4,background:"var(--border-soft)",borderRadius:2,margin:"0 auto 18px"}}),
      el("div",{style:{fontSize:14,fontWeight:700,color:"var(--text)",marginBottom:6}},`${year}년 ${month+1}월 — ${daysInMonth}일치`),
      el("div",{style:{fontSize:12,color:"var(--text-faint)",marginBottom:14,lineHeight:1.5}},
        `D / E / N / O ${customCode?` / ${customCode}`:""}  사용 · 미입력은 _`,
        customCode && customDesc && el("div",{style:{marginTop:2}},`${customCode} = ${customDesc}`)
      ),
      el("textarea",{
        value:text,
        onChange:e=>setText(e.target.value.toUpperCase().replace(/[^DENO_A-Z]/g,"").slice(0,daysInMonth+5)),
        placeholder:"DDEENNOO...",
        rows:4,
        style:{
          width:"100%",padding:"12px 14px",borderRadius:12,
          background:"var(--surface)",border:"1px solid #EFE6D5",
          fontSize:18,letterSpacing:"0.18em",fontWeight:700,
          fontFamily:"'SF Mono','Menlo',monospace",
          color:"var(--text)",lineHeight:1.5,resize:"none"
        }
      }),
      el("div",{style:{fontSize:11,color:"var(--text-fainter)",marginTop:6,textAlign:"right"}},
        `${text.replace(/\s/g,"").length} / ${daysInMonth}`),
      err && el("div",{style:{fontSize:13,color:MEMO_COLOR,marginTop:8}},err),
      el("div",{style:{display:"flex",gap:8,marginTop:14}},
        el("button",{onClick:onClose,
          style:{flex:1,padding:"14px 0",borderRadius:12,background:"var(--surface)",border:"1px solid #EFE6D5",color:"var(--text-sub)",fontSize:14,fontWeight:600}
        },"취소"),
        el("button",{onClick:handleSave,disabled:saving,
          style:{flex:2,padding:"14px 0",borderRadius:12,background:"var(--text)",color:"var(--surface)",fontSize:14,fontWeight:700,opacity:saving?0.5:1}
        },saving?"저장 중...":"저장")
      )
    )
  );
}

